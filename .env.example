# ============================================================
# AVISO IMPORTANTE — LEIA ANTES DE PUBLICAR
# ============================================================
# Este projeto é um SIMULADOR frontend. Qualquer credencial
# colocada em variáveis VITE_* é EMBUTIDA NO BUNDLE JAVASCRIPT
# e fica visível para qualquer pessoa que inspecionar o site.
#
# Isso é aceitável APENAS porque o sistema é 100% fictício
# (nenhum dinheiro real é movimentado).
#
# Para autenticação realmente segura, é necessário um BACKEND
# com hash de senha no servidor. Veja a seção "Segurança" do README.
# ============================================================

# Credenciais do painel administrativo (simulação)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=tesoureiro@145

# ------------------------------------------------------------
# SUPABASE (opcional) — sincronização do banco entre dispositivos
# ------------------------------------------------------------
# 1. Crie um projeto em https://supabase.com (grátis)
# 2. Execute o script supabase/setup.sql no SQL Editor
# 3. Copie as duas chaves abaixo de:
#    Project Settings → API → Project URL e anon public key
#
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
